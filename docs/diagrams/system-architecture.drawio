      <mxCell id="browser" value="&lt;div style=&quot;font-size:20px;font-weight:700;&quot;&gt;ブラウザ&lt;/div&gt;&lt;div style=&quot;margin-top:6px;font-size:16px;&quot;&gt;React / TypeScript&lt;/div&gt;&lt;div style=&quot;margin-top:14px;font-size:14px;line-height:24px;&quot;&gt;相談入力・結果表示&lt;br&gt;人物別履歴・振り返り&lt;br&gt;認証状態の管理&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#edf4ff;strokeColor=#7299cf;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=18;spacingLeft=18;spacingRight=12;fontFamily=Meiryo;fontSize=14;fontColor=#18364e;" vertex="1" parent="1"><mxGeometry x="48" y="305" width="230" height="190" as="geometry" /></mxCell>
