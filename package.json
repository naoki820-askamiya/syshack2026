{
  "name": "kigen404",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "lint": "tsc --noEmit --pretty false -p tsconfig.json",
    "lint:md": "markdownlint-cli2 \"README.md\" \"docs/**/*.md\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:client": "vite build",
    "build:server": "npm run prisma:generate && tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "dev": "vite",
    "server": "tsx src/server.ts",
    "server:dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "tsx --test \"src/backend/**/*.test.ts\"",
    "prisma:validate": "prisma validate --config src/backend/prisma.config.ts",
    "prisma:format": "prisma format --config src/backend/prisma.config.ts",
    "prisma:generate": "prisma generate --config src/backend/prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config src/backend/prisma.config.ts",
    "prisma:migrate:status": "prisma migrate status --config src/backend/prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@supabase/supabase-js": "^2.110.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "0.487.0",
    "openai": "^4.104.0",
    "pg": "^8.23.0",
    "react-router": "7.18.2",
    "recharts": "2.15.2",
    "tw-animate-css": "1.3.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^24.0.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "markdownlint-cli2": "0.23.2",
    "prisma": "7.9.1",
    "tailwindcss": "4.1.12",
    "tsx": "4.23.12",
    "typescript": "^5.8.3",
    "vite": "6.4.3"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    }
  }
}
